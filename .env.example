# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is ignored by git. Never commit real passwords or secrets.
#
# docker compose reads this file automatically, and every Spring Boot service
# loads it too (see spring.config.import in each service's application.yml).

# ---------- MySQL (user-service, url-service) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=change-me

# ---------- JPA (user-service, url-service) ----------
# update = Hibernate changes the tables for you (development); validate = only checks them (production)
JPA_DDL_AUTO=update
# true prints every SQL query in the logs
JPA_SHOW_SQL=false

# ---------- MongoDB (analytics-service) ----------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=analytics

# ---------- Redis (url-service cache, gateway rate limits, cancelled tokens) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Kafka (user-service, url-service, analytics-service) ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- JWT (user-service signs tokens, api-gateway checks them) ----------
# Base64 key of at least 256 bits. Generate one with:  openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl

# ---------- Gateway secret (api-gateway and every service) ----------
# The gateway sends it to the services; they reject requests without it.
# Generate with:  openssl rand -hex 32
GATEWAY_SECRET=change-me-generate-with-openssl

# ---------- Short links (url-service) ----------
# The address in front of every short link; the API gateway in local development.
SHORT_URL_BASE=http://localhost:8080

# ---------- Frontend (url-service) ----------
# Where the UI runs. Password-protected links send visitors to its /unlock page.
UI_BASE_URL=http://localhost:5173
